// File contracts/LHILecceNFT.sol

// Original license: SPDX_License_Identifier: MIT
pragma solidity ^0.8.26;

// Import corretti per l'ambiente Hardhat (da node_modules)



/**
 * @title LHILecceNFT
 * @notice Contratto ERC-1155 per la collezione LHI Lecce, compatibile con OZ v5.
 * @dev Questo contratto gestisce la creazione e la proprietà degli NFT ed è controllabile dai contratti Manager.
 */
contract LHILecceNFT is ERC1155, ERC1155Supply, Ownable {
    
    // Indirizzi dei contratti Manager che hanno il permesso di mintare
    address public fungibleManager;
    address public nonFungibleManager;

    // Evento per tracciare l'impostazione dei manager
    event ManagerSet(string managerType, address indexed managerAddr);

    /**
     * @notice Costruttore del contratto.
     * @param initialOwner L'indirizzo che diventerà l'owner del contratto.
     * @param uri_ L'URI di base per i metadati dei token.
     */
    constructor(address initialOwner, string memory uri_)
        ERC1155(uri_)
        Ownable(initialOwner)
    {}
    
    /**
     * @notice Imposta un nuovo URI di base per i metadati (solo owner).
     * @param newuri Il nuovo URI da impostare.
     */
    function setURI(string memory newuri) public onlyOwner {
        _setURI(newuri);
    }
    
    /**
     * @notice Imposta l'indirizzo del manager dei token fungibili (solo owner).
     * @param _manager L'indirizzo del contratto manager.
     */
    function setFungibleManager(address _manager) public onlyOwner {
        require(_manager != address(0), "Invalid manager address");
        fungibleManager = _manager;
        emit ManagerSet("FUNGIBLE", _manager);
    }
    
    /**
     * @notice Imposta l'indirizzo del manager dei token non fungibili (solo owner).
     * @param _manager L'indirizzo del contratto manager.
     */
    function setNonFungibleManager(address _manager) public onlyOwner {
        require(_manager != address(0), "Invalid manager address");
        nonFungibleManager = _manager;
        emit ManagerSet("NON_FUNGIBLE", _manager);
    }

    /**
     * @notice Funzione di mint pubblica, ma controllata.
     * @dev Può essere chiamata solo dai contratti Manager autorizzati.
     */
    function mint(address to, uint256 id, uint256 amount, bytes memory data) public {
        require(
            msg.sender == fungibleManager || msg.sender == nonFungibleManager,
            "Caller is not an authorized manager"
        );
        _mint(to, id, amount, data);
    }
    
    /**
     * @dev Correzione obbligatoria per OZ v5 per risolvere il conflitto di ereditarietà.
     */
    function _update(address from, address to, uint256[] memory ids, uint256[] memory amounts)
        internal
        override(ERC1155, ERC1155Supply)
    {
        super._update(from, to, ids, amounts);
    }
}


// File contracts/LHIManagerNFTNonFungibileToken.sol

// Original license: SPDX_License_Identifier: MIT
pragma solidity ^0.8.26;

// Import corretti per l'ambiente Hardhat (da node_modules)








contract LHIManagerNonFungibleToken is Initializable, AccessControlUpgradeable, ReentrancyGuardUpgradeable, PausableUpgradeable, UUPSUpgradeable {
    using SafeERC20 for IERC20;

    bytes32 public constant BRIDGE_ROLE = keccak256("BRIDGE_ROLE");
    bytes32 public constant METADATA_ROLE = keccak256("METADATA_ROLE");

    // ======================================================
    // === CORREZIONE 1: La variabile è ora 'address payable' ===
    // ======================================================
    address payable public lhiLecceNFT;

    // Supported payment tokens
    address public usdc;
    address public usdt;
    address public dai;
    address public weth;
    address public matic;
    address public polytrade;
    address public polydoge;

    mapping(uint256 => mapping(address => uint256)) public tokenPrices;
    mapping(uint256 => uint256) public mintLimits;
    mapping(address => bool) public mintControllers;
    uint256 public bridgeFee;
    address public feeWallet;
    address public creator;
    uint256 public royaltyPercentage;
    string public baseURI;

    event NFTContractSet(address indexed nft);
    event PaymentReceived(address indexed payer, address indexed token, uint256 amount, uint256 nftId, uint256 quantity);
    event Minted(address indexed to, uint256 indexed id, uint256 amount);

    function initialize(
        address admin,
        address _usdc,
        address _usdt,
        address _dai,
        address _weth,
        address _matic,
        address _polytrade,
        address _polydoge,
        address _feeWallet,
        address _creator,
        string memory _baseURI
    ) public initializer {
        __AccessControl_init();
        __ReentrancyGuard_init();
        __Pausable_init();
        __UUPSUpgradeable_init();
        _grantRole(DEFAULT_ADMIN_ROLE, admin);
        _grantRole(BRIDGE_ROLE, admin);
        _grantRole(METADATA_ROLE, admin);
        usdc = _usdc;
        usdt = _usdt;
        dai = _dai;
        weth = _weth;
        matic = _matic;
        polytrade = _polytrade;
        polydoge = _polydoge;
        feeWallet = _feeWallet;
        creator = _creator;
        royaltyPercentage = 500;
        bridgeFee = 100;
        baseURI = _baseURI;
    }

    function _authorizeUpgrade(address) internal override onlyRole(DEFAULT_ADMIN_ROLE) {}

    // =======================================================
    // === CORREZIONE 2: Il parametro è ora 'address payable' ===
    // =======================================================
    function setNFTContract(address payable _nft) external onlyRole(DEFAULT_ADMIN_ROLE) {
        require(_nft != address(0), "zero");
        lhiLecceNFT = _nft;
        emit NFTContractSet(_nft);
    }

    function setTokenPrice(uint256 tokenId, address paymentToken, uint256 price) external onlyRole(DEFAULT_ADMIN_ROLE) {
        tokenPrices[tokenId][paymentToken] = price;
    }

    function setMintLimit(uint256 tokenId, uint256 limit) external onlyRole(DEFAULT_ADMIN_ROLE) {
        mintLimits[tokenId] = limit;
    }

    function setMintController(address controller, bool enabled) external onlyRole(DEFAULT_ADMIN_ROLE) {
        mintControllers[controller] = enabled;
    }

    function payAndMintNFT(address paymentToken, address to, uint256 nftId, uint256 quantity) external nonReentrant whenNotPaused {
        require(lhiLecceNFT != address(0), "nft not set");
        require(quantity > 0 && nftId > 0, "invalid args");
        require(paymentToken == usdc || paymentToken == usdt || paymentToken == dai || paymentToken == weth || paymentToken == matic || paymentToken == polytrade || paymentToken == polydoge, "unsupported token");
        uint256 pricePer = tokenPrices[nftId][paymentToken];
        require(pricePer > 0, "price not set");
        if (mintLimits[nftId] > 0) {
            require(LHILecceNFT(lhiLecceNFT).totalSupply(nftId) + quantity <= mintLimits[nftId], "limit");
        }
        uint256 total = pricePer * quantity;
        uint256 royalty = (total * royaltyPercentage) / 10000;
        IERC20(paymentToken).safeTransferFrom(msg.sender, address(this), total);
        if (royalty > 0 && creator != address(0)) {
            IERC20(paymentToken).safeTransfer(creator, royalty);
        }
        require(bytes(baseURI).length > 0, "baseURI not set");
        LHILecceNFT(lhiLecceNFT).mint(to, nftId, quantity, "");
        emit PaymentReceived(msg.sender, paymentToken, total, nftId, quantity);
        emit Minted(to, nftId, quantity);
    }

    function controlledMintNFT(address to, uint256 nftId, uint256 quantity) external whenNotPaused {
        require(mintControllers[msg.sender], "not controller");
        if (mintLimits[nftId] > 0) {
            require(LHILecceNFT(lhiLecceNFT).totalSupply(nftId) + quantity <= mintLimits[nftId], "limit");
        }
        LHILecceNFT(lhiLecceNFT).mint(to, nftId, quantity, "");
        emit Minted(to, nftId, quantity);
    }

    mapping(address => mapping(uint256 => uint256)) public lockedForBridge;

    function depositForBridge(uint256 tokenId, uint256 amount) external nonReentrant whenNotPaused {
        require(tokenId > 0 && amount > 0, "bad args");
        LHILecceNFT(lhiLecceNFT).safeTransferFrom(msg.sender, address(this), tokenId, amount, "");
        lockedForBridge[msg.sender][tokenId] += amount;
    }

    function withdrawFromBridge(address user, uint256 tokenId, uint256 amount) external nonReentrant onlyRole(BRIDGE_ROLE) whenNotPaused {
        require(lockedForBridge[user][tokenId] >= amount, "insufficient balance");
        uint256 feeAmount = (amount * bridgeFee) / 10000;
        uint256 toSend = amount - feeAmount;
        lockedForBridge[user][tokenId] -= amount;
        LHILecceNFT(lhiLecceNFT).safeTransferFrom(address(this), user, tokenId, toSend, "");
        if (feeAmount > 0 && feeWallet != address(0)) {
            LHILecceNFT(lhiLecceNFT).safeTransferFrom(address(this), feeWallet, tokenId, feeAmount, "");
        }
    }

    function withdrawERC20(address token, address to, uint256 amount) external onlyRole(DEFAULT_ADMIN_ROLE) {
        IERC20(token).safeTransfer(to, amount);
    }

    function setBaseURI(string calldata _base) external onlyRole(DEFAULT_ADMIN_ROLE) {
        baseURI = _base;
    }
}
